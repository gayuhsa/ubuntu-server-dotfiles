//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

zone "lab.local" {
    type master;
    file "/etc/bind/zones/db.lab.local";
    allow-update { none; };
    allow-query { any; };
    allow-transfer { none; };
};

zone "student.lab.local" {
    type master; 
    file "/etc/bind/zones/db.student.lab.local";
    allow-update { none; };
    allow-query { any; };
};

zone "56.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.192.168.56";
    allow-update { none; };
    allow-query { any; };
    allow-transfer { none; };
};
